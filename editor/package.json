{
  "name": "datagov-inventory-editor",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Local-first React editor for DCAT-US 3.0 catalog authoring",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run lint && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/catalog/tsconfig.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "schema:update": "node scripts/dcat-us-pin.mjs update",
    "schema:check": "node scripts/dcat-us-pin.mjs check",
    "generate:models": "node scripts/generate-models.mjs",
    "generate:models:check": "npm run generate:models && git diff --exit-code src/generated/models/"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@trussworks/react-uswds": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": ">=11.0.1"
  }
}
